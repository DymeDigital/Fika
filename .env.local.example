# Copy to .env.local (git-ignored) to pull products from the Google Sheet locally.
# Without these, `npm run build` / `npm run dev` use the committed snapshot in
# lib/data/equipment.generated.json.

SHEET_ID=your-spreadsheet-id-from-the-sheet-url
GOOGLE_SHEETS_API_KEY=your-google-cloud-api-key-restricted-to-sheets-api
# Optional — defaults to "Products!A1:N2000"
# SHEET_RANGE=Products!A1:N2000
